@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15

start
:User enters an edit command;
:Read the recipe number;
if () then ([valid number and\nrecipe exists])
  :Find the title/, type/ and n/ values;
  if () then ([at least one value given,\nno prefix repeated,\nno value empty])
    if () then ([new title not used by\nanother recipe])
      :Apply every new value to the recipe;
      :Show the updated recipe;
    else ([else])
      :Show duplicate-title error;
    endif
  else ([else])
    :Show format error;
  endif
else ([else])
  :Show invalid-number error;
endif
stop
@enduml
