@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
hide empty members
hide circle
top to bottom direction

class WhatsCooking {
  +{static} main(args)
  -{static} loadRecipes(storage, ui): RecipeList
}
class Parser <<utility>> {
  +{static} parse(fullCommand, stockList): Command
}
abstract class Command {
  +{abstract} execute(recipes, ui)
  +isExit(): boolean
}
class AddCommand
class SubstituteCommand
class ExitCommand {
  +isExit(): boolean
}
class Ui {
  +readCommand(): String
  +showError(message)
}
class RecipeList
class Storage {
  +load(): RecipeList
  +save(recipes)
}

WhatsCooking ..> Parser : parse input
WhatsCooking ..> Command : execute
WhatsCooking ..> Ui : uses
WhatsCooking ..> Storage : uses
Parser ..> Command : creates
Command <|-- AddCommand
Command <|-- SubstituteCommand
Command <|-- ExitCommand
Command ..> RecipeList : reads/changes
Command ..> Ui : reports to
Storage ..> RecipeList : loads/saves
@enduml
