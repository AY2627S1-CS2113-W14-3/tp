@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
hide footbox

participant "<<class>>\nWhatsCooking" as App
participant ":Ui" as UI
participant "<<class>>\nParser" as Parser
participant "command:Command" as Command
participant ":Storage" as Storage

App -> UI : readCommand()
activate UI
UI --> App : fullCommand
deactivate UI

App -> Parser : parse(fullCommand, stockList)
activate Parser
create Command
Parser -> Command : create concrete command(...)
activate Command
note right of Command
  Concrete subclass selected
  from the command word.
end note
Command --> Parser : command
deactivate Command
Parser --> App : command
deactivate Parser

App -> Command : execute(recipes, ui)
activate Command
Command --> App
deactivate Command
App -> Storage : save(recipes)
activate Storage
Storage --> App
deactivate Storage
App -> Command : isExit()
activate Command
Command --> App : isExit
deactivate Command

note over App, Storage
  Successful path; repeated until isExit is true.
  If parse, execute or save throws WhatsCookingException,
  remaining calls are skipped. Ui.showError reports it,
  then the loop reads the next command.
  Command internals and error interactions are omitted.
end note
@enduml
