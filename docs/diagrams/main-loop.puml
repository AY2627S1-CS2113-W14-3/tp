@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
hide footbox

participant ":WhatsCooking" as App
participant ":Ui" as UI
participant "<<class>>\nParser" as Parser
participant "command:Command" as Command
participant ":Storage" as Storage

App -> UI : readCommand()
activate UI
UI --> App : fullCommand
deactivate UI

App -> Parser : parse(fullCommand, stockList)
activate Parser
create Command
Parser -> Command
Parser --> App : command
deactivate Parser

alt command word recognised and execution succeeds
  App -> Command : execute(recipes, ui)
  activate Command
  Command --> App
  deactivate Command
  App -> Storage : save(recipes)
  activate Storage
  Storage --> App
  deactivate Storage
  App -> Command : isExit()
  activate Command
  Command --> App : isExit
  deactivate Command
else WhatsCookingException from parse, execute or save
  App -> UI : showError(message)
  activate UI
  UI --> App
  deactivate UI
end

note over App, Storage
  Repeated until isExit is true. On an exception, isExit stays
  false and the loop reads the next command. The command's
  own calls to RecipeList and Ui are omitted.
end note
@enduml
