@startuml

box "Logic" #F5F5F5
participant "Parser" as Parser
participant "StockCommand" as StockCmd
participant "Ui" as Ui
end box

box "Model" #F5F5F5
participant "StockList" as Stock
participant "Ingredient" as Ing
end box

User -> Ui : "stock remove 2 eggs"
Ui -> Parser : parse(...)
Parser -> StockCmd : new StockCommand(...)
StockCmd -> Ing : new Ingredient("2 eggs")
Ing --> StockCmd : ingredient
StockCmd -> Stock : remove(ingredient)

activate Stock
Stock -> Stock : find matching item
alt enough quantity
    Stock -> Stock : subtract quantity
    Stock --> StockCmd : success
else insufficient
    Stock --> StockCmd : throw WhatsCookingException
end
deactivate Stock

StockCmd -> Ui : showMessage("Removed...")
@enduml