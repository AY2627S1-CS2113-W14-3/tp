@startuml

box "Logic" #F5F5F5
participant "Parser" as Parser
participant "StockCommand" as StockCmd
participant "Ui" as Ui
end box

box "Model" #F5F5F5
participant "StockList" as Stock
participant "StockItem" as Item
participant "Ingredient" as Ing
end box

User -> Ui : "stock remove 2 eggs"
Ui -> Parser : parse("stock remove 2 eggs", stockList)
Parser -> StockCmd : new StockCommand(...)
StockCmd -> Ing : new Ingredient("2 eggs")
Ing --> StockCmd : ingredient
StockCmd -> Item : new StockItem(ingredient, null)
Item --> StockCmd : stockItem

StockCmd -> Stock : remove(stockItem)

activate Stock
Stock -> Stock : find all matching StockItems
Stock -> Stock : sort by expiry date (earliest first)
alt total quantity is enough
    Stock -> Item : setQuantity(new quantity)
    Stock --> StockCmd : success
else insufficient quantity
    Stock --> StockCmd : throw WhatsCookingException
end
deactivate Stock

StockCmd -> Ui : showMessage("Removed...")

@enduml