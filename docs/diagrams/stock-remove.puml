@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
hide footbox

participant "<<class>>\nWhatsCooking" as App
participant ":StockCommand" as Command
participant "stockList:StockList" as Stock
participant "item:StockItem" as Item
participant ":Ui" as UI

App -> Command : execute(recipes, ui)
activate Command
note right of Command
  Parse "remove 2 eggs" and construct toRemove.
  Parser and temporary object creation are omitted.
end note
Command -> Stock : remove(toRemove)
activate Stock
Stock -> Stock : collect matches and validate total quantity
activate Stock
Stock --> Stock
deactivate Stock
note right of Stock
  Missing or insufficient stock throws before any change.
  The remainder shows a successful removal only.
end note
Stock -> Stock : sort matches by expiry (undated last)
activate Stock
Stock --> Stock
deactivate Stock
loop matching batches while remainingToRemove > 0
  alt batch is consumed completely (within tolerance)
    Stock -> Stock : remove batch and reduce remainingToRemove
    activate Stock
    Stock --> Stock
    deactivate Stock
  else batch has a remainder
    Stock -> Item : setQuantity(newQuantity)
    activate Item
    Item --> Stock
    deactivate Item
    note right of Stock : Set remainingToRemove to zero.
  end
end
Stock --> Command
deactivate Stock
Command -> UI : showMessage("Removed from stock: 2 eggs")
activate UI
UI --> Command
deactivate UI
Command --> App
deactivate Command

note over Stock, Item
  Self-calls are pseudocode for in-method work.
  Quantity/name getters and tiny-residual cleanup are omitted.
end note
@enduml
